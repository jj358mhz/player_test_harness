# Flask
FLASK_APP=app
FLASK_ENV=production
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-32

# Encryption key for Uplynk API keys at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-with-fernet

# Database
DATABASE_URL=sqlite:////app/data/player-test-harness.db

# Bootstrap admin (created on first startup if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# Uplynk API + playback hosts (usually no need to change)
UPLYNK_API_BASE=https://services.uplynk.com
UPLYNK_CONTENT_BASE=https://content.uplynk.com

# Default lifetime of signed playback tokens, in seconds
PLAYBACK_TOKEN_TTL=3600
